<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Journal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="container">
        <%- include('../partials/flash') %>
        <h4>Edit Journal - <em><%= journal.destination %></em> (destination cannot be changed)</h4>
        <form action="/journals/<%= journal._id %>?_method=PUT" method="POST" class="needs-validation" novalidate style="max-width:500px">
            <div class="mb-2">
                <label for="arrivalDate">Arrival Date</label>
                <input type="date" class="form-control" id="arrivalDate" name="journal[arrivalDate]"
                    value="<%= journal.arrivalDate.toISOString().substring(0,10) %>" required>
                <div class="invalid-feedback">Please enter an arrival date.</div>
            </div>
            <div class="mb-2">
                <label for="departureDate">Departure Date</label>
                <input type="date" class="form-control" id="departureDate" name="journal[departureDate]"
                    value="<%= journal.departureDate.toISOString().substring(0,10) %>" required>
                <div class="invalid-feedback">Departure must be after arrival date.</div>
            </div>
            <div class="mb-2">
                <label for="experience">Experience</label>
                <textarea class="form-control" id="experience" name="journal[experience]" rows="4" required minlength="10"><%= journal.experience %></textarea>
                <div class="invalid-feedback">Please write at least 10 characters.</div>
            </div>
            <div class="mb-3">
                <label for="rating">Rating (1-5)</label>
                <select class="form-select" id="rating" name="journal[rating]" required>
                    <option value="" disabled>Select...</option>
                    <option value="1" <%= journal.rating === 1 ? 'selected' : '' %>>1</option>
                    <option value="2" <%= journal.rating === 2 ? 'selected' : '' %>>2</option>
                    <option value="3" <%= journal.rating === 3 ? 'selected' : '' %>>3</option>
                    <option value="4" <%= journal.rating === 4 ? 'selected' : '' %>>4</option>
                    <option value="5" <%= journal.rating === 5 ? 'selected' : '' %>>5</option>
                </select>
                <div class="invalid-feedback">Please select a rating.</div>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Update</button>
            <a href="/journals/<%= journal._id %>">Cancel</a>
        </form>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/validation.js"></script>
</body>
</html>
