<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Journals</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="container">
        <%- include('../partials/flash') %>
        <div class="d-flex justify-content-between mb-3">
            <h4>My Journals</h4>
            <a href="/journals/new" class="btn btn-sm btn-secondary">New Entry</a>
        </div>
        <% if (journals.length === 0) { %>
            <p>No journal entries yet.</p>
        <% } else { %>
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th>Destination</th>
                        <th>Arrival</th>
                        <th>Departure</th>
                        <th>Rating</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let journal of journals) { %>
                        <tr>
                            <td><%= journal.destination %></td>
                            <td><%= journal.arrivalDate.toDateString() %></td>
                            <td><%= journal.departureDate.toDateString() %></td>
                            <td><%= journal.rating %>/5</td>
                            <td>
                                <a href="/journals/<%= journal._id %>">View</a> |
                                <a href="/journals/<%= journal._id %>/edit">Edit</a> |
                                <form action="/journals/<%= journal._id %>?_method=DELETE" method="POST" style="display:inline">
                                    <button type="submit" style="background:none;border:none;padding:0;color:blue;cursor:pointer;" onclick="return confirm('Delete?')">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        <% } %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
