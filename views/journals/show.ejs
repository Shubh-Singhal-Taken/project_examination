<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= journal.destination %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="container">
        <%- include('../partials/flash') %>
        <h4><%= journal.destination %></h4>
        <table class="table table-bordered table-sm" style="max-width:500px">
            <tr><th>Arrival Date</th><td><%= journal.arrivalDate.toDateString() %></td></tr>
            <tr><th>Departure Date</th><td><%= journal.departureDate.toDateString() %></td></tr>
            <tr><th>Experience</th><td><%= journal.experience %></td></tr>
            <tr><th>Rating</th><td><%= journal.rating %>/5</td></tr>
            <tr><th>Author</th><td><%= journal.author.username %></td></tr>
        </table>
        <a href="/journals/<%= journal._id %>/edit">Edit</a> |
        <form action="/journals/<%= journal._id %>?_method=DELETE" method="POST" style="display:inline">
            <button type="submit" style="background:none;border:none;padding:0;color:blue;cursor:pointer;" onclick="return confirm('Delete?')">Delete</button>
        </form> |
        <a href="/journals">Back</a>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
