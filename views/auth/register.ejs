<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Register</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="container">
        <%- include('../partials/flash') %>
        <h4>Register</h4>
        <form action="/register" method="POST" class="needs-validation" novalidate style="max-width:400px">
            <div class="mb-2">
                <label for="username">Username</label>
                <input type="text" class="form-control" id="username" name="username" required minlength="3">
                <div class="invalid-feedback">At least 3 characters.</div>
            </div>
            <div class="mb-2">
                <label for="password">Password</label>
                <input type="password" class="form-control" id="password" name="password" required minlength="6">
                <div class="invalid-feedback">At least 6 characters.</div>
            </div>
            <div class="mb-2">
                <label for="nationality">Nationality</label>
                <input type="text" class="form-control" id="nationality" name="nationality" required>
                <div class="invalid-feedback">Required.</div>
            </div>
            <div class="mb-2">
                <label for="travelStyle">Travel Style</label>
                <select class="form-select" id="travelStyle" name="travelStyle" required>
                    <option value="" disabled selected>Select...</option>
                    <option>Adventure</option>
                    <option>Luxury</option>
                    <option>Backpacker</option>
                    <option>Cultural</option>
                    <option>Beach</option>
                </select>
                <div class="invalid-feedback">Required.</div>
            </div>
            <div class="mb-3">
                <label for="favoriteContinent">Favorite Continent</label>
                <select class="form-select" id="favoriteContinent" name="favoriteContinent" required>
                    <option value="" disabled selected>Select...</option>
                    <option>Africa</option>
                    <option>Asia</option>
                    <option>Europe</option>
                    <option>North America</option>
                    <option>South America</option>
                    <option>Oceania</option>
                    <option>Antarctica</option>
                </select>
                <div class="invalid-feedback">Required.</div>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Register</button>
        </form>
        <p class="mt-2"><a href="/login">Already have an account?</a></p>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/validation.js"></script>
</body>
</html>
